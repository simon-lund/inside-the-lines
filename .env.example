# Server-side only — never exposed to the browser.
# Set ONE key. With several set, AI_PROVIDER picks; otherwise the first in this order wins.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Optional: anthropic | openai | mistral
AI_PROVIDER=

# Optional model overrides. AI_MODEL writes whole apps in the studio;
# AI_FAST_MODEL assembles one module per click in the OS.
# Defaults: anthropic claude-opus-5-5 / claude-sonnet-5-5
#           openai    gpt-6-astra     / gpt-6-luna
#           mistral   mistral-large-latest / mistral-small-latest
AI_MODEL=
AI_FAST_MODEL=
