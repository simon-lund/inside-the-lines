# Server-side only — never exposed to the browser.
# Set ONE key. With several set, AI_PROVIDER picks; otherwise the first in this order wins.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Optional: anthropic | openai | mistral
AI_PROVIDER=

# Optional model override (assembles the modules).
# Defaults: anthropic claude-sonnet-5-5 · openai gpt-6-luna · mistral mistral-small-latest
AI_MODEL=
